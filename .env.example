# Worktree 专属配置。
# 新工作区执行 `./scripts/mtb init` 时会自动生成，不要从其他工作区复制。
MTB_WORKTREE_ID=main
MTB_WORKTREE_SLOT=0
MTB_BIND_HOST=127.0.0.1
MTB_BROWSER_HOST=localhost

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# DeepSeek 配置不会自动复制。
# 使用 real-agent 时，需要手动复制到新工作区；不要提交 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# AI Core 参数已有相同的代码默认值，通常不需要复制。
# 如果修改了这些值，并希望新工作区保持相同行为，再手动复制。
AI_CORE_AGENT_DRIVER=mock
AI_CORE_AGENT_PROFILE_PATH=data/agent-knowledge/node_exporter.md
AI_CORE_AGENT_MAX_ITERATIONS=6
AI_CORE_AGENT_MAX_TOOL_CALLS=12
AI_CORE_AGENT_TIMEOUT=60s
AI_CORE_MODEL_TIMEOUT=30s
AI_CORE_MCP_TOOL_TIMEOUT=12s
