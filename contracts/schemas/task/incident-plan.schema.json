{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-torchbearing.local/contracts/schemas/task/incident-plan.schema.json",
  "title": "IncidentPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceId", "alertName", "alertFingerprint", "serviceRef", "labels", "mapping", "playbook", "assetRefs", "phase", "diagnosis", "intent"],
  "properties": {
    "sourceId": {"type": "string", "minLength": 1, "maxLength": 80},
    "alertName": {"type": "string", "minLength": 1, "maxLength": 120},
    "alertFingerprint": {"type": "string", "minLength": 1, "maxLength": 200},
    "serviceRef": {"type": "string", "minLength": 1, "maxLength": 120},
    "labels": {"type": "object", "maxProperties": 24, "additionalProperties": {"type": "string", "maxLength": 200}},
    "mapping": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}},
    "playbook": {"type": "object", "additionalProperties": false, "required": ["id", "version", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}},
    "assetRefs": {"type": "array", "minItems": 3, "maxItems": 8, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "version", "digest"], "properties": {"kind": {"type": "string", "enum": ["knowledge", "skill", "playbook", "alert_mapping"]}, "id": {"type": "string", "minLength": 1, "maxLength": 120}, "version": {"type": "string", "minLength": 1, "maxLength": 40}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}},
    "phase": {"type": "string", "enum": ["load_assets", "observe", "needs_agent", "prepare", "needs_approval", "execute", "verify_runtime", "verify_metrics", "verify_business", "completed", "no_action"]},
    "diagnosis": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["primaryHypothesis", "evidenceRefs", "alternativeHypotheses", "confidence", "candidateAction"], "properties": {"primaryHypothesis": {"type": "string", "enum": ["worker_stopped", "slow_processing", "dependency_errors", "healthy", "insufficient_evidence"]}, "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}}, "alternativeHypotheses": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "maxLength": 120}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "candidateAction": {"type": "string", "enum": ["restore_worker_concurrency", "no_action"]}}}]},
    "intent": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["id", "digest", "capabilityId", "serviceRef", "instanceEpoch", "expectedVersion", "beforeConcurrency", "afterConcurrency", "risk", "createdAt"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "capabilityId": {"const": "order_service.restore_worker_concurrency"}, "serviceRef": {"type": "string", "minLength": 1}, "instanceEpoch": {"type": "string", "minLength": 1}, "expectedVersion": {"type": "integer", "minimum": 1}, "beforeConcurrency": {"const": 0}, "afterConcurrency": {"const": 2}, "risk": {"type": "string", "enum": ["low"]}, "createdAt": {"type": "string", "format": "date-time"}}}]}
  }
}
