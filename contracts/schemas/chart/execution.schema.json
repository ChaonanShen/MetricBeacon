{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-torchbearing.local/contracts/schemas/chart/execution.schema.json",
  "title": "ChartExecution",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "queryRefId", "status", "seriesCount", "durationMs", "sampleRange", "series", "warnings", "createdAt"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "queryRefId": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["success", "failed"]},
    "seriesCount": {"type": "integer", "minimum": 0},
    "durationMs": {"type": "integer", "minimum": 0},
    "sampleRange": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string", "format": "date-time"}, "to": {"type": "string", "format": "date-time"}}},
    "series": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "labels", "points"], "properties": {"name": {"type": "string"}, "labels": {"type": "object", "additionalProperties": {"type": "string"}}, "points": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["timestamp", "value"], "properties": {"timestamp": {"type": "string", "format": "date-time"}, "value": {"type": "number"}}}}}}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
