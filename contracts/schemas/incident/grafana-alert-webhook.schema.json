{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-torchbearing.local/contracts/schemas/incident/grafana-alert-webhook.schema.json",
  "title": "GrafanaAlertWebhook",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiver", "status", "alerts"],
  "properties": {
    "receiver": {"type": "string", "minLength": 1, "maxLength": 200},
    "status": {"type": "string", "enum": ["firing", "resolved"]},
    "orgId": {"type": "integer", "minimum": 1},
    "alerts": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/alert"}},
    "groupLabels": {"$ref": "#/$defs/labels"},
    "commonLabels": {"$ref": "#/$defs/labels"},
    "commonAnnotations": {"$ref": "#/$defs/labels"},
    "externalURL": {"type": "string", "maxLength": 500},
    "appVersion": {"type": "string", "maxLength": 80},
    "version": {"type": "string", "maxLength": 40},
    "groupKey": {"type": "string", "maxLength": 500},
    "truncatedAlerts": {"type": "integer", "minimum": 0},
    "title": {"type": "string", "maxLength": 500},
    "state": {"type": "string", "maxLength": 80},
    "message": {"type": "string", "maxLength": 2000}
  },
  "$defs": {
    "labels": {"type": "object", "maxProperties": 24, "additionalProperties": {"type": "string", "maxLength": 500}},
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "labels", "annotations", "startsAt", "endsAt", "fingerprint"],
      "properties": {
        "status": {"type": "string", "enum": ["firing", "resolved"]},
        "labels": {"allOf": [{"$ref": "#/$defs/labels"}, {"required": ["alertname", "service_ref"], "properties": {"alertname": {"type": "string", "minLength": 1}, "service_ref": {"type": "string", "minLength": 1}}}]},
        "annotations": {"$ref": "#/$defs/labels"},
        "startsAt": {"type": "string", "format": "date-time"},
        "endsAt": {"type": "string", "format": "date-time"},
        "generatorURL": {"type": "string", "maxLength": 1000},
        "fingerprint": {"type": "string", "minLength": 1, "maxLength": 200},
        "silenceURL": {"type": "string", "maxLength": 1000},
        "dashboardURL": {"type": "string", "maxLength": 1000},
        "panelURL": {"type": "string", "maxLength": 1000},
        "imageURL": {"type": "string", "maxLength": 1000},
        "values": {"type": "object", "maxProperties": 24, "additionalProperties": {"oneOf": [{"type": "number"}, {"type": "string", "maxLength": 100}]}},
        "valueString": {"type": "string", "maxLength": 2000}
      }
    }
  }
}
