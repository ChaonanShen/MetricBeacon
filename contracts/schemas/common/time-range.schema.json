{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-torchbearing.local/contracts/schemas/common/time-range.schema.json",
  "title": "TimeRange",
  "$defs": {
    "absolute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "format": "date-time"},
        "to": {"type": "string", "format": "date-time"}
      }
    },
    "relative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativeDuration"],
      "properties": {
        "relativeDuration": {"type": "string", "pattern": "^[1-9][0-9]*[smhdw]$"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/absolute"},
    {"$ref": "#/$defs/relative"}
  ]
}
