{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-torchbearing.local/contracts/schemas/common/request-context.schema.json",
  "title": "RequestContext",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "orgId", "userId", "roles", "permissions", "requestId", "traceId"],
  "properties": {
    "tenantId": {"type": "string", "minLength": 1},
    "orgId": {"type": "string", "minLength": 1},
    "userId": {"type": "string", "minLength": 1},
    "roles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "requestId": {"type": "string", "minLength": 1},
    "traceId": {"type": "string", "minLength": 1}
  }
}
