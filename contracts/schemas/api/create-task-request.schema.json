{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-torchbearing.local/contracts/schemas/api/create-task-request.schema.json",
  "title": "CreateTaskRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "message", "analysisContext"],
  "properties": {
    "sessionId": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "analysisContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasourceUid"],
      "properties": {
        "datasourceUid": {"type": "string", "enum": ["prometheus-main"]},
        "timeRange": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string", "format": "date-time"}, "to": {"type": "string", "format": "date-time"}}},
            {"type": "object", "additionalProperties": false, "required": ["relativeDuration"], "properties": {"relativeDuration": {"type": "string", "pattern": "^[1-9][0-9]*[smhdw]$"}}}
          ]
        }
      }
    }
  }
}
