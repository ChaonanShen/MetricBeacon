{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-torchbearing.local/contracts/schemas/assets/knowledge.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "title", "serviceRef", "healthyState", "content"],
  "properties": {
    "kind": {"const": "knowledge"},
    "id": {"const": "order-service"},
    "version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "serviceRef": {"const": "order-demo"},
    "healthyState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerConcurrency", "queueTrend", "businessProbe"],
      "properties": {
        "workerConcurrency": {"const": 2},
        "queueTrend": {"const": "stable_or_decreasing"},
        "businessProbe": {"const": "completed_within_5s"}
      }
    },
    "content": {"type": "string", "minLength": 100, "maxLength": 12000}
  }
}
