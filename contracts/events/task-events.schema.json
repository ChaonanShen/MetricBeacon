{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-torchbearing.local/contracts/events/task-events.schema.json",
  "title": "TaskEvent",
  "$defs": {
    "taskEventError": {
      "type": "object", "additionalProperties": true, "required": ["code", "message", "retryable", "requestId"],
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "retryable": {"type": "boolean"}, "requestId": {"type": "string"}}
    },
    "taskSnapshot": {
      "type": "object", "additionalProperties": true, "required": ["id", "sessionId", "status"],
      "properties": {"id": {"type": "string"}, "sessionId": {"type": "string"}, "status": {"type": "string"}}
    },
    "message": {
      "type": "object", "additionalProperties": true, "required": ["id", "sessionId", "taskId", "role", "content", "createdAt"],
      "properties": {"id": {"type": "string"}, "sessionId": {"type": "string"}, "taskId": {"type": "string"}, "role": {"type": "string"}, "content": {"type": "string"}, "createdAt": {"type": "string", "format": "date-time"}}
    },
    "candidate": {
      "type": "object", "additionalProperties": true, "required": ["metricName", "type", "description", "labels", "score", "sources"],
      "properties": {"metricName": {"type": "string"}, "type": {"type": "string"}, "description": {"type": "string"}, "labels": {"type": "array"}, "score": {"type": "number"}, "sources": {"type": "array"}}
    },
    "chart": {
      "type": "object", "additionalProperties": true, "required": ["id", "taskId", "title", "status"],
      "properties": {"id": {"type": "string"}, "taskId": {"type": "string"}, "title": {"type": "string"}, "status": {"type": "string"}}
    },
    "execution": {
      "type": "object", "additionalProperties": true, "required": ["id", "status", "series", "seriesCount"],
      "properties": {"id": {"type": "string"}, "status": {"type": "string"}, "series": {"type": "array"}, "seriesCount": {"type": "integer", "minimum": 0}}
    },
    "taskCreated": {
      "type": "object", "additionalProperties": false, "required": ["task"],
      "properties": {"task": {"$ref": "#/$defs/taskSnapshot"}}
    },
    "statusChanged": {
      "type": "object", "additionalProperties": false, "required": ["previousStatus", "status"],
      "properties": {
        "previousStatus": {"type": "string", "enum": ["created", "planning", "running_tools", "waiting_approval", "executing", "reconciling", "validating", "completed", "failed", "cancelled"]},
        "status": {"type": "string", "enum": ["created", "planning", "running_tools", "waiting_approval", "executing", "reconciling", "validating", "completed", "failed", "cancelled"]},
        "error": {"$ref": "#/$defs/taskEventError"}
      }
    },
    "assistantStarted": {
      "type": "object", "additionalProperties": false, "required": ["messageId", "role"],
      "properties": {"messageId": {"type": "string", "minLength": 1}, "role": {"const": "assistant"}}
    },
    "assistantDelta": {
      "type": "object", "additionalProperties": false, "required": ["messageId", "delta", "ordinal"],
      "properties": {"messageId": {"type": "string", "minLength": 1}, "delta": {"type": "string", "minLength": 1}, "ordinal": {"type": "integer", "minimum": 1}}
    },
    "assistantCompleted": {
      "type": "object", "additionalProperties": false, "required": ["message"],
      "properties": {"message": {"$ref": "#/$defs/message"}}
    },
    "toolStarted": {
      "type": "object", "additionalProperties": false, "required": ["toolCallId", "toolName", "toolVersion", "inputSummary"],
      "properties": {
        "toolCallId": {"type": "string", "minLength": 1}, "toolName": {"type": "string", "minLength": 1}, "toolVersion": {"const": "v1"},
        "inputSummary": {"type": "object", "additionalProperties": true}
      }
    },
    "toolCompleted": {
      "type": "object", "additionalProperties": false, "required": ["toolCallId", "toolName", "durationMs", "outputSummary"],
      "properties": {
        "toolCallId": {"type": "string", "minLength": 1}, "toolName": {"type": "string", "minLength": 1}, "durationMs": {"type": "integer", "minimum": 0},
        "outputSummary": {"type": "object", "additionalProperties": true}
      }
    },
    "toolFailed": {
      "type": "object", "additionalProperties": false, "required": ["toolCallId", "toolName", "durationMs", "error"],
      "properties": {
        "toolCallId": {"type": "string", "minLength": 1}, "toolName": {"type": "string", "minLength": 1}, "durationMs": {"type": "integer", "minimum": 0},
        "error": {"$ref": "#/$defs/taskEventError"}
      }
    },
    "metricCandidates": {
      "type": "object", "additionalProperties": false, "required": ["candidates"],
      "properties": {"candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}}
    },
    "chartCreated": {
      "type": "object", "additionalProperties": false, "required": ["chart"],
      "properties": {"chart": {"$ref": "#/$defs/chart"}}
    },
    "chartExecutionCompleted": {
      "type": "object", "additionalProperties": false, "required": ["chartId", "execution", "chartStatus"],
      "properties": {
        "chartId": {"type": "string", "minLength": 1}, "execution": {"$ref": "#/$defs/execution"}, "chartStatus": {"const": "ready"}
      }
    },
    "taskCompleted": {
      "type": "object", "additionalProperties": false, "required": ["task"],
      "properties": {"task": {"$ref": "#/$defs/taskSnapshot"}}
    },
    "taskFailed": {
      "type": "object", "additionalProperties": false, "required": ["task", "error"],
      "properties": {
        "task": {"$ref": "#/$defs/taskSnapshot"},
        "error": {"$ref": "#/$defs/taskEventError"}
      }
    },
    "alertReceived": {
      "type": "object", "additionalProperties": false, "required": ["sourceId", "alertName", "fingerprint", "serviceRef", "status", "startsAt"],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1}, "alertName": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "minLength": 1}, "serviceRef": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["firing", "resolved"]}, "startsAt": {"type": "string", "format": "date-time"}
      }
    },
    "playbookResolved": {
      "type": "object", "additionalProperties": false, "required": ["mappingId", "mappingDigest", "playbookId", "playbookVersion", "playbookDigest"],
      "properties": {
        "mappingId": {"type": "string", "minLength": 1}, "mappingDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "playbookId": {"type": "string", "minLength": 1}, "playbookVersion": {"type": "string", "minLength": 1},
        "playbookDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "assetsPinned": {
      "type": "object", "additionalProperties": false, "required": ["assets"],
      "properties": {"assets": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "version", "digest"], "properties": {"kind": {"type": "string", "enum": ["knowledge", "skill", "playbook", "alert_mapping"]}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}}}
    },
    "diagnosisCompleted": {
      "type": "object", "additionalProperties": false, "required": ["primaryHypothesis", "evidenceRefs", "alternativeHypotheses", "confidence", "candidateAction"],
      "properties": {
        "primaryHypothesis": {"type": "string", "enum": ["worker_stopped", "slow_processing", "dependency_errors", "healthy", "insufficient_evidence"]},
        "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "alternativeHypotheses": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "candidateAction": {"type": "string", "enum": ["restore_worker_concurrency", "no_action"]}
      }
    },
    "intentPrepared": {
      "type": "object", "additionalProperties": false, "required": ["intentId", "intentDigest", "capabilityId", "serviceRef", "instanceEpoch", "expectedVersion", "beforeConcurrency", "afterConcurrency", "risk"],
      "properties": {
        "intentId": {"type": "string", "minLength": 1}, "intentDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "capabilityId": {"const": "order_service.restore_worker_concurrency"}, "serviceRef": {"type": "string", "minLength": 1},
        "instanceEpoch": {"type": "string", "minLength": 1}, "expectedVersion": {"type": "integer", "minimum": 1},
        "beforeConcurrency": {"const": 0}, "afterConcurrency": {"const": 2}, "risk": {"const": "low"}
      }
    },
    "approvalRequested": {
      "type": "object", "additionalProperties": false, "required": ["approvalId", "intentDigest", "expiresAt", "version"],
      "properties": {"approvalId": {"type": "string", "minLength": 1}, "intentDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "expiresAt": {"type": "string", "format": "date-time"}, "version": {"type": "integer", "minimum": 1}}
    },
    "approvalDecided": {
      "type": "object", "additionalProperties": false, "required": ["approvalId", "status", "decidedBy", "decidedAt", "version"],
      "properties": {"approvalId": {"type": "string", "minLength": 1}, "status": {"type": "string", "enum": ["approved", "rejected", "expired"]}, "decidedBy": {"type": "string", "minLength": 1}, "decidedAt": {"type": "string", "format": "date-time"}, "version": {"type": "integer", "minimum": 2}}
    },
    "remediationOperation": {
      "type": "object", "additionalProperties": false, "required": ["operationId", "intentDigest", "state"],
      "properties": {"operationId": {"type": "string", "minLength": 1}, "intentDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "state": {"type": "string", "enum": ["started", "applied", "already_applied", "failed", "unknown"]}}
    },
    "verification": {
      "type": "object", "additionalProperties": false, "required": ["passed", "observedAt", "summary"],
      "properties": {"passed": {"type": "boolean"}, "observedAt": {"type": "string", "format": "date-time"}, "summary": {"type": "string", "minLength": 1, "maxLength": 500}}
    },
    "auditRecorded": {
      "type": "object", "additionalProperties": false, "required": ["auditId", "action", "outcome"],
      "properties": {"auditId": {"type": "string", "minLength": 1}, "action": {"type": "string", "enum": ["approval_decision", "remediation_execute", "remediation_verify"]}, "outcome": {"type": "string", "enum": ["accepted", "rejected", "succeeded", "failed"]}}
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "taskId", "sessionId", "sequence", "type", "timestamp", "payload"],
  "properties": {
    "eventId": {"type": "string", "minLength": 1},
    "taskId": {"type": "string", "minLength": 1},
    "sessionId": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "type": {"type": "string", "enum": ["task.created", "task.status_changed", "assistant.message.started", "assistant.message.delta", "assistant.message.completed", "tool.started", "tool.completed", "tool.failed", "metric.candidates_created", "chart.created", "chart.execution_completed", "task.completed", "task.failed", "alert.received", "playbook.resolved", "assets.pinned", "diagnosis.completed", "intent.prepared", "approval.requested", "approval.decided", "remediation.started", "remediation.reconciled", "verification.runtime", "verification.metrics", "verification.business", "audit.recorded"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  },
  "oneOf": [
    {"properties": {"type": {"const": "task.created"}, "payload": {"$ref": "#/$defs/taskCreated"}}},
    {"properties": {"type": {"const": "task.status_changed"}, "payload": {"$ref": "#/$defs/statusChanged"}}},
    {"properties": {"type": {"const": "assistant.message.started"}, "payload": {"$ref": "#/$defs/assistantStarted"}}},
    {"properties": {"type": {"const": "assistant.message.delta"}, "payload": {"$ref": "#/$defs/assistantDelta"}}},
    {"properties": {"type": {"const": "assistant.message.completed"}, "payload": {"$ref": "#/$defs/assistantCompleted"}}},
    {"properties": {"type": {"const": "tool.started"}, "payload": {"$ref": "#/$defs/toolStarted"}}},
    {"properties": {"type": {"const": "tool.completed"}, "payload": {"$ref": "#/$defs/toolCompleted"}}},
    {"properties": {"type": {"const": "tool.failed"}, "payload": {"$ref": "#/$defs/toolFailed"}}},
    {"properties": {"type": {"const": "metric.candidates_created"}, "payload": {"$ref": "#/$defs/metricCandidates"}}},
    {"properties": {"type": {"const": "chart.created"}, "payload": {"$ref": "#/$defs/chartCreated"}}},
    {"properties": {"type": {"const": "chart.execution_completed"}, "payload": {"$ref": "#/$defs/chartExecutionCompleted"}}},
    {"properties": {"type": {"const": "task.completed"}, "payload": {"$ref": "#/$defs/taskCompleted"}}},
    {"properties": {"type": {"const": "task.failed"}, "payload": {"$ref": "#/$defs/taskFailed"}}},
    {"properties": {"type": {"const": "alert.received"}, "payload": {"$ref": "#/$defs/alertReceived"}}},
    {"properties": {"type": {"const": "playbook.resolved"}, "payload": {"$ref": "#/$defs/playbookResolved"}}},
    {"properties": {"type": {"const": "assets.pinned"}, "payload": {"$ref": "#/$defs/assetsPinned"}}},
    {"properties": {"type": {"const": "diagnosis.completed"}, "payload": {"$ref": "#/$defs/diagnosisCompleted"}}},
    {"properties": {"type": {"const": "intent.prepared"}, "payload": {"$ref": "#/$defs/intentPrepared"}}},
    {"properties": {"type": {"const": "approval.requested"}, "payload": {"$ref": "#/$defs/approvalRequested"}}},
    {"properties": {"type": {"const": "approval.decided"}, "payload": {"$ref": "#/$defs/approvalDecided"}}},
    {"properties": {"type": {"const": "remediation.started"}, "payload": {"$ref": "#/$defs/remediationOperation"}}},
    {"properties": {"type": {"const": "remediation.reconciled"}, "payload": {"$ref": "#/$defs/remediationOperation"}}},
    {"properties": {"type": {"const": "verification.runtime"}, "payload": {"$ref": "#/$defs/verification"}}},
    {"properties": {"type": {"const": "verification.metrics"}, "payload": {"$ref": "#/$defs/verification"}}},
    {"properties": {"type": {"const": "verification.business"}, "payload": {"$ref": "#/$defs/verification"}}},
    {"properties": {"type": {"const": "audit.recorded"}, "payload": {"$ref": "#/$defs/auditRecorded"}}}
  ]
}
