{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-torchbearing.local/contracts/tools/incident/inputs.schema.json",
  "$defs": {
    "AssetGetInput": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "ResolveAlertInput": {
      "type": "object", "additionalProperties": false, "required": ["sourceId", "alertName", "labels"],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1}, "alertName": {"type": "string", "minLength": 1},
        "labels": {"type": "object", "maxProperties": 20, "additionalProperties": {"type": "string", "maxLength": 200}}
      }
    },
    "StartRunInput": {
      "type": "object", "additionalProperties": false, "required": ["playbookId", "version", "digest", "serviceRef"],
      "properties": {"playbookId": {"type": "string"}, "version": {"type": "string"}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "serviceRef": {"const": "order-demo"}}
    },
    "ResumeRunInput": {
      "type": "object", "additionalProperties": false, "required": ["checkpoint", "diagnosis"],
      "properties": {
        "checkpoint": {"type": "string", "minLength": 1, "maxLength": 4096},
        "diagnosis": {
          "type": "object", "additionalProperties": false,
          "required": ["primaryHypothesis", "evidenceRefs", "alternatives", "confidence", "candidateAction"],
          "properties": {
            "primaryHypothesis": {"type": "string", "minLength": 1, "maxLength": 500},
            "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 1}},
            "alternatives": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "candidateAction": {"type": "string", "enum": ["restore_worker_concurrency", "no_action"]}
          }
        }
      }
    },
    "EmptyInput": {"type": "object", "additionalProperties": false},
    "RecentOutcomesInput": {
      "type": "object", "additionalProperties": false,
      "properties": {"status": {"type": "string", "enum": ["queued", "processing", "completed", "failed"]}, "limit": {"type": "integer", "minimum": 1, "maximum": 20, "default": 10}}
    },
    "GetOperationInput": {
      "type": "object", "additionalProperties": false, "required": ["operationId"],
      "properties": {"operationId": {"type": "string", "minLength": 1, "maxLength": 100}}
    }
  }
}

