{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-torchbearing.local/contracts/tools/grafana/query-prometheus.input.schema.json",
  "title": "grafana.query_prometheus input",
  "type": "object",
  "additionalProperties": false,
  "required": ["datasourceUid", "view", "cpuRateWindowSeconds", "start", "end", "stepSeconds", "mode"],
  "properties": {
    "datasourceUid": {"type": "string", "enum": ["prometheus-main"]},
    "view": {"type": "string", "enum": ["cpu", "memory", "load"]},
    "cpuRateWindowSeconds": {"anyOf": [{"type": "integer", "enum": [30, 60, 300]}, {"type": "null"}]},
    "start": {"type": "string", "format": "date-time"},
    "end": {"type": "string", "format": "date-time"},
    "stepSeconds": {"type": "integer", "enum": [5, 10, 15, 30, 60, 120, 300]},
    "mode": {"type": "string", "enum": ["validate", "execute"]}
  }
}
