{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-torchbearing.local/contracts/tools/grafana/search-metrics.output.schema.json",
  "title": "grafana.search_metrics output",
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricName", "type", "description", "labels", "score", "sources"],
      "properties": {
        "metricName": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["counter", "gauge", "histogram", "summary", "unknown"]},
        "description": {"type": "string", "minLength": 1},
        "labels": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "sources": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["type", "reference"], "properties": {"type": {"const": "mock_fixture"}, "reference": {"const": "node_exporter_overview"}}}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {"candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}}
}
